PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
DATABASE_PATH=./data/bidata.sqlite
# sample = clearly labelled demo; live = your validated feed, never sample fallback
DATA_MODE=sample
TENDERS_FILE=./data/tenders.json
FEED_MAX_AGE_HOURS=24
# Off until reviewed and configured; use test keys first.
PAYMENTS_ENABLED=false
# off | test | live. Sample tenders only support test payments.
BILLING_MODE=off
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PRIVACY_URL=
TERMS_URL=
SUPPORT_EMAIL=
